# All variables here are NEXT_PUBLIC_-prefixed because they are read by
# browser-side code (lib/api/client.ts, lib/supabase/client.ts).
#
# The Supabase anon key is safe to expose client-side by design (rate-limited,
# RLS-governed) — never put the service-role key in this file or anywhere in
# the frontend.

# Base URL of the backend Express API (see backend/openapi.json for the contract)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser): used by
# the marketing site's server-rendered /pricing page and homepage to fetch
# live plan data region-aware, since one Vercel deployment serves both
# regions' marketing content but each region has its own backend/Supabase
# project. Both point at the same backend today until the India/International
# VM split (see deploy/README.md) stands up a second one.
BACKEND_API_URL_IN=http://localhost:4000/api
BACKEND_API_URL_INTL=http://localhost:4000/api

# Supabase project URL and anon (public) key, used for direct Auth SDK calls
# (signUp / signInWithPassword) from the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
